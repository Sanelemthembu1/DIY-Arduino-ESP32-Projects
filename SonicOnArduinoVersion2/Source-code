void moveSonic(){
	if (invincible && millis() - hurtStartTime >= HURT_DURATION_MS) {
		invincible = false;
		isHurt = false;
	}
 if (killed) {
    //falling under gravity until he's off the bottom of the screen
    if (sonicY < 80) {
      vy += gravity;
      sonicY += vy;
    }
    display.drawBitmap(sonicX, sonicY, epd_bitmap_SonicR_Array[1], 18, 24, SSD1306_WHITE);
    return;
  }

  joyX = analogRead(A0);
  joyY = analogRead(A1);

if (joyX > 600) {
    if (sonicX < CAMERA_X) {
        vx += moveSpeed;
    } else {
        worldOffset += 1.2;
    }
}
else if (joyX < 400) {
    if (worldOffset > 0) {
        worldOffset -= 1.2;
    } else {
        vx -= moveSpeed;
