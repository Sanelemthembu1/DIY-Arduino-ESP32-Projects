void drawBoss(){

		if(bossVisible && bossY<=5 && bossX<180){
			display.drawBitmap((int)bossX, (int)bossY, epd_bitmap_bossL, 33,22 , SSD1306_WHITE);
			bossY+=0.5;
		}

		else if(bossVisible && bossY>5){
			display.drawBitmap((int)bossX, (int)bossY, epd_bitmap_bossR, 33,22 , SSD1306_WHITE);
			//bossVisible=false;
			if(bossX>360) bossVisible=false;
			bossX+=2;
		}

    if(bossFight && tempBossY<=5){
			display.drawBitmap((int)tempBossX, (int)tempBossY, epd_bitmap_bossLC3, 33,58 , SSD1306_WHITE);
			if (bossAnim >= 4)bossAnim=4;
			tempBossY += 1;
			bossAnim  ++;
		}

		else if(bossFight && tempBossY>5){
			tempBossX+=bossDirection;
			tempBossRec+=recDirection;
			if(tempBossX  > 100) bossDirection = -2;
			if(tempBossX  < 0)  bossDirection  =  2;
			if(tempBossRec > 6)  recDirection  = -0.5;
			if(tempBossRec < 0)  recDirection  =  0.5;
			if(bossDirection<0){
			  display.drawBitmap((int)tempBossX, (int)tempBossY, epd_bitmap_bosslc[(int)tempBossRec], bosslrecxpx[(int)tempBossRec],bosslrecypx[(int)tempBossRec], SSD1306_WHITE);
			}
			else if(bossDirection>0){
			  display.drawBitmap((int)tempBossX, (int)tempBossY, epd_bitmap_bossrc[(int)tempBossRec], bossrrecxpx[(int)tempBossRec],bossrrecypx[(int)tempBossRec] , SSD1306_WHITE);
			}
		}
		drawBossHealthBar();
}

