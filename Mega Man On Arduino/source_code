void checkJackCollision() {
  if (!jackAlive) return;

  bool compressed = !jackAirborne;
  int jw = compressed ? JACK_W_COMPRESSED : JACK_W_EXTENDED;
  int jh = compressed ? JACK_H_COMPRESSED : JACK_H_EXTENDED;
  int jDrawY = (int)jackY + (JACK_H_EXTENDED - jh);
  float jScreenX = jackX - worldOffset;

  if (!aabbCollide(mario_x, mario_y, PLAYER_W, PLAYER_H,
                    jScreenX, jDrawY, jw, jh)) {
    return;
  }

  float prevBottom = (mario_y + PLAYER_H) - vy;
  bool stomping = (vy > 0.5) && (prevBottom <= jDrawY + 6);

  if (stomping) {
    jackAlive = false;
    score += 100;
    vy = jumpForce * 0.6; // stomp bounce (separate from hurt knockback)
  } else {
    hitPlayer(jScreenX);
  }
}

// ---------------------------------------------------------------------
// 2. NINJA BULLETS vs PLAYER
// ---------------------------------------------------------------------

void checkNinjaBulletsVsPlayer() {
  for (int b = 0; b < MAX_NINJA_BULLETS; b++) {
    if (!ninjaBulletActive[b]) continue;
    float bx = ninjaBulletX[b] - worldOffset;
    if (aabbCollide(mario_x, mario_y, PLAYER_W, PLAYER_H,
                     bx, ninjaBulletY[b], 3, 3)) {
      ninjaBulletActive[b] = false;
      hitPlayer(bx);
    }
  }
}


// ---------------------------------------------------------------------
// 3. BURGER BULLETS vs PLAYER
// ---------------------------------------------------------------------

void checkBurgerBulletsVsPlayer() {
  for (int b = 0; b < MAX_BURGER_BULLETS; b++) {
    if (!burgerBulletActive[b]) continue;
    float bx = burgerBulletX[b] - worldOffset;
    float by = burgerBulletY[b];
    if (aabbCollide(mario_x, mario_y, PLAYER_W, PLAYER_H,
                     bx, by, 3, 3)) {
      burgerBulletActive[b] = false;
      hitPlayer(bx);
    }
  }
}

// ---------------------------------------------------------------------
// 4. PLAYER BULLETS vs ENEMIES (kills, except hidden ninja)
// ---------------------------------------------------------------------
void checkPlayerBulletsVsEnemies() {
  for (int b = 0; b < MAX_BULLETS; b++) {
    if (!bulletActive[b]) continue;
    float px = bulletX[b];
    float py = bulletY[b];

    // vs Jack
    if (jackAlive) {
      bool compressed = !jackAirborne;
      int jw = compressed ? JACK_W_COMPRESSED : JACK_W_EXTENDED;
      int jh = compressed ? JACK_H_COMPRESSED : JACK_H_EXTENDED;
      int jDrawY = (int)jackY + (JACK_H_EXTENDED - jh);
      float jScreenX = jackX - worldOffset;
      if (aabbCollide(px, py, 4, 3, jScreenX, jDrawY, jw, jh)) {
        jackAlive = false;
        bulletActive[b] = false;
        score += 100;
        continue;
      }
    }

    // vs Ninja (only when NOT hidden)
    if (ninjaAlive && ninjaState != NINJA_HIDDEN) {
      float nScreenX = ninjaX - worldOffset;
      if (aabbCollide(px, py, 4, 3, nScreenX, ninjaY, 21, 20)) {
        ninjaAlive = false;
        bulletActive[b] = false;
        score += 150;
				//playStompSound();
        continue;
      }
    }

    // vs Burger
    if (burgerAlive) {
      float bScreenX = burgerX - worldOffset;
      int bw = 7;
      int bh = (burgerState == BURGER_HIDDEN) ? 7 : 9;
      if (aabbCollide(px, py, 4, 3, bScreenX, burgerY, bw, bh)) {
        burgerAlive = false;
        bulletActive[b] = false;
				//playStompSound();
        score += 100;
        continue;
      }
    }
  }
}
