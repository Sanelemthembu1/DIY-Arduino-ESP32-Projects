// --- Generic AABB test (all args must already be in the SAME space) ---
bool aabbCollide(float ax, float ay, int aw, int ah,
                  float bx, float by, int bw, int bh) {
  return ax < bx + bw && ax + aw > bx &&
         ay < by + bh && ay + ah > by;
}

