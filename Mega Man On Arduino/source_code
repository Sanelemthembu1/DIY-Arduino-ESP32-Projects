// bar geometry
const int HEALTH_BAR_X = 4;
const int HEALTH_BAR_Y = 25;
const int HEALTH_BAR_W = 8;
const int HEALTH_BAR_H = 20;          // total height of the outer rectangle
const int HEALTH_SEGMENT_H = HEALTH_BAR_H / MAX_HEALTH;  // height per stripe
const int HEALTH_SEGMENT_GAP = 1;     // gap between stripes so they read as separate

void drawHealth() {
  // outer frame
  display.drawRect(HEALTH_BAR_X, HEALTH_BAR_Y, HEALTH_BAR_W, HEALTH_BAR_H, SSD1306_WHITE);

  // fill segments from the bottom up, so it drains like a canister
  for (int seg = 0; seg < MAX_HEALTH; seg++) {
    if (seg >= health) continue;   // empty segment: skip, leaves it hollow

    int segY = HEALTH_BAR_Y + HEALTH_BAR_H - (seg + 1) * HEALTH_SEGMENT_H;
    display.fillRect(HEALTH_BAR_X + 1, segY + HEALTH_SEGMENT_GAP,
                      HEALTH_BAR_W - 2, HEALTH_SEGMENT_H - HEALTH_SEGMENT_GAP,
                      SSD1306_WHITE);
  }
}
