const unsigned long RESPAWN_DELAY = 4000; // ms enemy stays dead before respawn is eligible
const int RESPAWN_BUFFER_MIN = 15;        // min distance past screen edge
const int RESPAWN_BUFFER_MAX = 60;        // max distance past screen edge
const float WORLD_MIN = 0;
const float WORLD_MAX = 256;              // two backgrounds wide

// Picks a world-x just outside the visible window. Prefers spawning
// AHEAD of the player (off the right edge, so it scrolls in as they
// keep moving forward); falls back to spawning BEHIND if there's no
// room ahead (e.g. camera already maxed out at worldOffset=128).
float pickRespawnWorldX() {
  float visibleRight = worldOffset + 128;
  float ahead = visibleRight + RESPAWN_BUFFER_MIN +
                random(0, RESPAWN_BUFFER_MAX - RESPAWN_BUFFER_MIN);

  if (ahead <= WORLD_MAX) {
    return ahead;
  }

  float behind = worldOffset - RESPAWN_BUFFER_MIN -
                 random(0, RESPAWN_BUFFER_MAX - RESPAWN_BUFFER_MIN);
  return max(behind, WORLD_MIN);
}
