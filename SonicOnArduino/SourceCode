void updateRings() {
  float dx1 = sonicX + 5;
  float dx2 = sonicX + 15;
  float dy1 = sonicY + 3;
  float dy2 = sonicY + 20;


  for (int r = 0; r < NUM_RINGS; r++) {
    if (!ringAlive[r]) continue;


    int screenX = ringX[r] - worldOffset;


    // Skip drawing/checking if off-screen (saves cycles)
    if (screenX < -8 || screenX > 128) continue;


    // Collision check (6x8 ring hitbox)
    if (dx2 > screenX && dx1 < screenX + 6 &&
        dy2 > ringY[r] && dy1 < ringY[r] + 8) {
      ringAlive[r] = false;   // ring disappears
      score++;                // increment score
      //playRingSound();        // 
      continue;               // don't draw it this frame
    }


    display.drawBitmap(screenX, ringY[r], epd_bitmap_rings, 6, 8, SSD1306_WHITE);
  }
}
void flickSonic(float hitSourceScreenX) {
  if (invincible) return; // ignore hits while already flickering
  isHurt = true;
  invincible = true;
  hurtStartTime = millis();
  vy = jumpForce * 0.5;                              // small hop
  vx = (sonicX < hitSourceScreenX) ? -2.0 : 2.0;      // knock away from source
  onGround = false;
  // playHurtSound(); // if you have one
}


void DrawBackground(){
  display.drawBitmap(2, 2, epd_bitmap_lablogo, 21, 17, SSD1306_WHITE);
  //epd_bitmap_clod1


  // Which world-tile is currently under the left edge of the camera?
  int screen = (int)(worldOffset / 128);


  // Draw that tile and the one after it, so there's always a tile
  // sliding in from the right before the current one fully exits.
  for (int s = screen; s <= screen + 1; s++) {
    int x = s * 128 - (int)worldOffset;
    
    //display.drawBitmap(90+x, 0, epd_bitmap_clod1, 22, 12, SSD1306_WHITE);


    if (s < FINAL_SCREEN) {
      display.drawBitmap(x, 55, epd_bitmap_floor, 128, 9, SSD1306_WHITE);
    }
    else if (s == FINAL_SCREEN) {
      display.drawBitmap(x, 0, epd_bitmap_lastStage, 128, 64, SSD1306_WHITE);
    }
    // s > FINAL_SCREEN: nothing to draw, world ends there
  }
}


