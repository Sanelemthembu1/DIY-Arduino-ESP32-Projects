      marioI+=walkD;
      i+=walkD;
    if(marioI>2.6){
      walkD= -0.3;
    }
    if(marioI<=0){
      walkD= 0.3;
    }
      display.drawBitmap(sonicX, sonicY, epd_bitmap_SonicL_Array[(int)marioI], xpx[(int)i], 27, SSD1306_WHITE);


    } else{
      display.drawBitmap(sonicX, sonicY, epd_bitmap_sonicRB, 20, 27, SSD1306_WHITE);
    }
  }
  
}


