void moveSonic(){
  if (invincible && millis() - hurtStartTime >= HURT_DURATION_MS) {
    invincible = false;
    isHurt = false;
  }
 if (killed) {
    //falling under gravity until he's off the bottom of the screen
    if (sonicY < 80) {
      vy += gravity;
      sonicY += vy;
    }
    display.drawBitmap(sonicX, sonicY, epd_bitmap_SonicR_Array[1], 18, 24, SSD1306_WHITE);
    return;
  }


  joyX = analogRead(A0);
  joyY = analogRead(A1);


if (joyX > 600) {
    if (sonicX < CAMERA_X) {
        vx += moveSpeed;
    } else {
        worldOffset += 1.2;
    }
}
else if (joyX < 400) {
    if (worldOffset > 0) {
        worldOffset -= 1.2;
    } else {
        vx -= moveSpeed;
    }
}
  vx *= 0.9;


  // Jump
  if (joyY > 600 && onGround) {
    vy = jumpForce;
    onGround = false;
    jumpFrame = 0;          // reset spin so every jump starts clean
  }


  vy += gravity;


  sonicX += vx;
  sonicY += vy;


  // Ground collisions
if (sonicY > 28 && vy >= 0 && !killed) {
  sonicY = 28;
  vy = 0;
  onGround = true;
  jumpFrame = 0;            // reset spin on landing
}
updateRings();
drawScore();
float dx1 = sonicX + 5;
float dx2 = sonicX + 15;
float dy1 = sonicY + 3;
float dy2 = sonicY + 20;


// Obstacle 1 (Tot)
if (totAlive &&
    dx2 >  motoBugX - worldOffset &&
    dx1 <  motoBugX - worldOffset + 10 &&
    dy2 >  motoBugY &&
    dy1 <  motoBugY + 8)
{
    if (vy > 0 && sonicY + 20 < motoBugY + 5)
    {
        totFalling = true;
        sonicY = motoBugY - 20;
        vy = jumpForce * 0.6;
        playStompSound();
    }
    else if (!invincible) {
    flickSonic(motoBugX - worldOffset);
}
    vy -= 2;
    vy += gravity;
    sonicX += vx;
    sonicY += vy;
    onGround = true;   // NOTE: see flag below — this blocks spin during bounce
}


//Obstacle 2 (Bug)
if (bugAlive &&
    dx2 >  meatBugX - worldOffset &&
    dx1 <  meatBugX - worldOffset + 13 &&
    dy2 >  meatBugY &&
    dy1 <  meatBugY + 8)
{
    if (vy > 0 && sonicY + 20 < meatBugY + 5)
    {
        bugFalling = true;
        sonicY = meatBugY - 20;
        vy = jumpForce * 0.6;
        playStompSound();
    }
    else if (!invincible) {
    flickSonic(meatBugX - worldOffset);
    }
    vy -= 2;
    vy += gravity;
    sonicX += vx;
    sonicY += vy;
    onGround = true;   // NOTE: same as above
}


if (bossFight) {


    int16_t bossScreenX = tempBossX - worldOffset;
    int16_t bossScreenY = tempBossY;


    int16_t stompLeft    = bossScreenX;
    int16_t stompRight   = bossScreenX + 33;
    int16_t stompTop     = bossScreenY;
    int16_t stompBottom  = bossScreenY + 20;


    int16_t rockLeft     = bossScreenX;
    int16_t rockRight    = bossScreenX + 33;
    int16_t rockTop      = bossScreenY + 30;
    int16_t rockBottom   = bossScreenY + 58;


    unsigned long currentMillis = millis();


    if (sonicX >= stompLeft && sonicX < stompRight &&
        sonicY >= stompTop  && sonicY <= stompBottom) {


        if (currentMillis - lastStompTime >= 500) {
            playStompSound();
            lastStompTime = currentMillis;
        }


    } else if (!invincible &&
               sonicX >= rockLeft && sonicX < rockRight &&
               sonicY >= rockTop  && sonicY <= rockBottom) {


        if (currentMillis - lastFlickTime >= 500) {
            flickSonic(bossScreenX + 16);
            lastFlickTime = currentMillis;
        }
    }
}


  if (worldOffset>30){
    bossVisible = true;
  }
  if (worldOffset>246){
    bossFight = true;
  }
  if (sonicX < 0) {
    sonicX = 0;
    vx = 0;
  }
  if (sonicX > 120) {
    sonicX = 120;
    vx = 0;
  }


bool spriteVisible = true;
if (invincible) {
    spriteVisible = ((millis() - hurtStartTime) / FLICKER_INTERVAL_MS) % 2 == 0;
}


if (spriteVisible) {


  if (!onGround) {
    // --- Jump/spin animation ---
    jumpFrame += jumpFrameSpeed;
    if (jumpFrame >= JUMP_FRAME_COUNT) jumpFrame = 0;


    if (joyX < 400) {
      display.drawBitmap(sonicX, sonicY, epd_bitmap_SonicJumpL_Array[(int)jumpFrame], rpx[(int)jumpFrame], rpi[(int)jumpFrame], SSD1306_WHITE);
